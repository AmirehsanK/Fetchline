<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit.v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fetchline.Cli\Fetchline.Cli.csproj" />
    <ProjectReference Include="..\..\src\Fetchline.Core\Fetchline.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same small helpers the unit tests use to find the repository and run a command. -->
    <Compile Include="..\Fetchline.Tests\Repo.cs" Link="Support\Repo.cs" />
    <Compile Include="..\Fetchline.Tests\Support\Vectors.cs" Link="Support\Vectors.cs" />
    <Compile Include="..\Fetchline.Tests\Support\Configurations.cs" Link="Support\Configurations.cs" />
    <Compile Include="..\Fetchline.Tests\Cli\CommandLine.cs" Link="Support\CommandLine.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The repository root is fixed at build time, so no test depends on the working directory. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
