@using System.Diagnostics
@using Fetchline.Core.Isa
@using Fetchline.Core.Trace
@using Fetchline.Viz.Editor
@using Fetchline.Viz.Explain
@using Fetchline.Viz.Export
@inject IJSRuntime Js

@*
    What the tube shows: a status line, the switches, the timeline, the panes, and a row of soft
    keys. All of it is drawn from one Session, which is replaced by a new one whenever the source
    or a switch changes. What is on screen is also kept, a moment behind, in the fragment of the
    page's address, so that the address is always a link to it.
*@
<div class="desk">
    <header class="status">
        <span class="inverse">&nbsp;FETCHLINE&nbsp;</span>
        <span class="notice" role="status">@_notice</span>
        <span class="status-end" role="status">@Standing.Of(_session, Going, Messages)</span>
    </header>

    <SwitchesBar Config="_session.Config" Messages="Messages" OnChange="Rebuild" />

    @* The timeline: the run so far from end to end, and a handle on the cycle on screen. *@
    <div class="timeline">
        <input type="range" min="0" max="@_session.Frontier" step="1" value="@_session.Cycle"
               style="--at: @(Fraction())%" disabled="@(_session.Frontier == 0)" aria-label="@Messages.Timeline"
               @oninput="Scrub" />
        <span class="dim">@Messages.TimelineRun(_session.Frontier)</span>
        @* The menu saves the run as a file and goes back to saying only that it is the menu. *@
        <select class="menu" @key="_exported" aria-label="@Messages.ExportMenu" disabled="@(_session.Cycle == 0)" @onchange="Export">
            <option value="" selected>@Messages.ExportMenu</option>
            @foreach (var kind in Enum.GetValues<ExportKind>())
            {
                <option value="@kind">@Messages.NameOf(kind)</option>
            }
        </select>
    </div>

    <SourcePane View="_source" Record="_session.Record" Messages="Messages" OnEdit="Edit" />

    @if (_compare is not null && _session.Program is { } compared)
    {
        <ComparePane Job="_compare" Program="compared" Current="_session.Config" Messages="Messages" OnChoose="Rebuild" />
    }
    else if (_datapath)
    {
        <DatapathPane Session="_session" Labels="_labels" Messages="Messages" />
    }
    else
    {
        <PipelinePane Session="_session" Labels="_labels" Messages="Messages" />
    }

    <LogPane Session="_session" Labels="_labels" Messages="Messages" OnSeek="Seek" />

    <div class="side">
        <RegistersPane Session="_session" Style="@(_labels?.Registers ?? RegisterStyle.Abi)" Messages="Messages" />
        <StatePane Session="_session" Messages="Messages" />
    </div>

    <footer class="softkeys" role="toolbar" aria-label="@Messages.Controls">
        <button type="button" class="softkey" aria-keyshortcuts="F5" disabled="@(!Going && !_session.CanStep)" @onclick="RunOrPause">
            <span class="softkey-fn">F5</span><span class="softkey-name inverse">@(Going ? Messages.PauseKey : Messages.RunKey)</span>
        </button>
        <button type="button" class="softkey" aria-keyshortcuts="F10" disabled="@(!_session.CanStep)" @onclick="Step">
            <span class="softkey-fn">F10</span><span class="softkey-name inverse">@Messages.StepKey</span>
        </button>
        <button type="button" class="softkey" aria-keyshortcuts="F9" disabled="@(!_session.CanStepBack)" @onclick="Back">
            <span class="softkey-fn">F9</span><span class="softkey-name inverse">@Messages.BackKey</span>
        </button>
        <button type="button" class="softkey" aria-keyshortcuts="F8" disabled="@(!_session.CanStepBack)" @onclick="Reset">
            <span class="softkey-fn">F8</span><span class="softkey-name inverse">@Messages.ResetKey</span>
        </button>
        <button type="button" class="softkey" aria-keyshortcuts="F6" @onclick="Faster">
            <span class="softkey-fn">F6</span><span class="softkey-name inverse">@Messages.SpeedKey(_pace.Name)</span>
        </button>
        <button type="button" class="softkey" aria-keyshortcuts="F7" disabled="@(_session.Program is null)" @onclick="CompareOrDiagram">
            <span class="softkey-fn">F7</span><span class="softkey-name inverse">@(_compare is null ? Messages.CompareKey : Messages.DiagramKey)</span>
        </button>
        <button type="button" class="softkey" aria-keyshortcuts="F4" @onclick="DatapathOrDiagram">
            <span class="softkey-fn">F4</span><span class="softkey-name inverse">@(_datapath && _compare is null ? Messages.StaircaseKey : Messages.DatapathKey)</span>
        </button>
        <button type="button" class="softkey" aria-keyshortcuts="F2" @onclick="Share">
            <span class="softkey-fn">F2</span><span class="softkey-name inverse">@Messages.ShareKey</span>
        </button>
    </footer>
</div>

@code {
    // A configuration is compared for this long before it is cut off as still running. The
    // comparison is made in stretches of this many cycles, one after another until the page is
    // due to be drawn again.
    private const ulong MostCyclesCompared = 250_000;
    private const ulong CyclesComparedAtOnce = 1_000;

    // How long a flat-out run goes on between one drawing of the page and the next.
    private const int FlatOutMilliseconds = 60;

    // How long what is on screen has to stay as it is before the address is brought up to date
    // with it, and how long something said on the status line stays there.
    private const int SettleMilliseconds = 400;
    private const int NoticeMilliseconds = 6000;

    private static readonly IMessages Messages = EnglishMessages.Instance;

    private Session _session = default!;
    private SourceView _source = default!;
    private InstructionLabels? _labels;

    private RunPace _pace = RunPace.Default;

    // The comparison on screen in place of the diagram, finished or still being made.
    private CompareJob? _compare;

    // The datapath is on screen in place of the diagram.
    private bool _datapath;

    // Set while the run is going on its own; cancelling it is how the run is paused.
    private CancellationTokenSource? _going;
    private DotNetObjectReference<App>? _self;

    // The cycle a link the page was opened with points at; the run goes there once it is on screen.
    private ulong _openAt;

    // What the status line is saying for the moment, and counters that tell a newer notice or
    // a newer state of the screen from the one a timer was started for.
    private string _notice = string.Empty;
    private int _noticed;
    private int _touched;

    private bool Going => _going is not null;

    // In the browser the page can be asked things without waiting, which is how the address is
    // read before anything is drawn.
    private IJSInProcessRuntime Page => (IJSInProcessRuntime)Js;

    /// <summary>
    /// The page starts with what its address says, when it says something: a link is a source,
    /// the switches and a cycle. A link that cannot be read is said to be so, and the first
    /// example is shown, as it is when there is no link at all.
    /// </summary>
    protected override void OnInitialized()
    {
        var fragment = Page.Invoke<string>("fetchlineLink.read");
        if (fragment.Length <= 1)
        {
            Load(ExampleCatalog.First.Source, null);
        }
        else if (ShareLink.TryDecode(fragment, out var shared, out var problem))
        {
            Load(shared.Source, shared.Config);
            _openAt = shared.Cycle;
        }
        else
        {
            Load(ExampleCatalog.First.Source, null);
            Say(Messages.LinkNotRead(problem));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("fetchlineKeys.listen", _self);
        await Js.InvokeVoidAsync("fetchlineLink.listen", _self);
        if (_openAt > 0)
        {
            _ = Go(until: _openAt);
        }
    }

    /// <summary>
    /// Called by the page when its address is given another fragment while it is open: a link
    /// pasted over the one that was there. A link that can be read replaces what is on screen;
    /// one that cannot is said to be so, and what is on screen stays.
    /// </summary>
    [JSInvokable]
    public void Followed(string fragment)
    {
        if (ShareLink.TryDecode(fragment, out var shared, out var problem))
        {
            Load(shared.Source, shared.Config);
            if (shared.Cycle > 0)
            {
                _ = Go(until: shared.Cycle);
            }
        }
        else if (fragment.Length > 1)
        {
            Say(Messages.LinkNotRead(problem));
            Touch();
        }

        StateHasChanged();
    }

    /// <summary>Called by the page when one of the function keys on the soft keys is pressed.</summary>
    [JSInvokable]
    public void Pressed(string key)
    {
        switch (key)
        {
            case "F2":
                _ = Share();
                break;
            case "F4":
                DatapathOrDiagram();
                break;
            case "F5":
                RunOrPause();
                break;
            case "F6":
                Faster();
                break;
            case "F7":
                CompareOrDiagram();
                break;
            case "F8":
                Reset();
                break;
            case "F9":
                Back();
                break;
            case "F10":
                Step();
                break;
        }

        StateHasChanged();
    }

    // Every keystroke in the editor is a new program, and so a new run from reset.
    private void Edit(string text) => Load(text, _session?.Config);

    // A switch moved is the same program on a pipeline built another way: a new run again.
    private void Rebuild(PipelineConfig config) => Load(_session.Source, config);

    // A new program or a new way of building the pipeline also brings the diagram back: a
    // comparison is of one program, and choosing one of its rows is how it is left.
    private void Load(string text, PipelineConfig? config)
    {
        Halt();
        _compare = null;
        _session = new Session(text, config);
        _source = SourceView.Of(_session.Assembly);
        _labels = _session.Program is { } program ? new InstructionLabels(program) : null;
        Touch();
    }

    // The diagram and the datapath are two views of the same cycle; asking for either leaves
    // the comparison, which is of whole runs.
    private void DatapathOrDiagram()
    {
        _datapath = _compare is not null || !_datapath;
        _compare = null;
    }

    private void CompareOrDiagram()
    {
        if (_compare is not null)
        {
            _compare = null;
        }
        else if (_session.Program is { } program)
        {
            _compare = new CompareJob(program, Comparison.Configurations(_session.Config), MostCyclesCompared);
            _ = Compare(_compare);
        }
    }

    /// <summary>
    /// Makes a comparison a stretch at a time, drawing the rows it has between stretches, for
    /// as long as it is still the comparison on screen.
    /// </summary>
    private async Task Compare(CompareJob job)
    {
        while (ReferenceEquals(_compare, job) && !job.IsDone)
        {
            var spent = Stopwatch.StartNew();
            while (job.Advance(CyclesComparedAtOnce) && spent.ElapsedMilliseconds < FlatOutMilliseconds)
            {
            }

            StateHasChanged();
            await Task.Delay(1);
        }

        StateHasChanged();
    }

    private void RunOrPause()
    {
        if (Going)
        {
            Halt();
            Touch();
        }
        else if (_session.CanStep)
        {
            _ = Go();
        }
    }

    /// <summary>
    /// Lets the run go on its own: some cycles, a pause in which the page is drawn and the keys
    /// are heard, and again, until it ends, pauses at an ebreak, or is told to stop.
    /// </summary>
    /// <param name="until">
    /// A cycle to go to and stop at, flat out whatever the pace is set to: how the page gets to
    /// the cycle a link points at.
    /// </param>
    private async Task Go(ulong until = ulong.MaxValue)
    {
        var going = _going = new CancellationTokenSource();
        try
        {
            while (!going.IsCancellationRequested && _session.CanStep && _session.Cycle < until)
            {
                // Flat out, drawing the page costs far more than running the cycles drawn, so
                // bursts follow one another until a fair share of a frame has been spent on them.
                var pace = until == ulong.MaxValue ? _pace : RunPace.All[^1];
                var spent = Stopwatch.StartNew();
                int ran;
                do
                {
                    ran = _session.Run((int)Math.Min((ulong)pace.Cycles, until - _session.Cycle));
                }
                while (pace.IsFlatOut && ran == pace.Cycles && _session.CanStep && _session.Cycle < until
                    && _session.Stopped != StopReason.Breakpoint && spent.ElapsedMilliseconds < FlatOutMilliseconds);

                if (ran == 0 || _session.Stopped == StopReason.Breakpoint)
                {
                    break;
                }

                StateHasChanged();
                await Task.Delay(pace.Milliseconds, going.Token);
            }
        }
        catch (OperationCanceledException)
        {
            // Paused.
        }
        finally
        {
            if (ReferenceEquals(_going, going))
            {
                _going = null;
                Touch();
            }

            going.Dispose();
            StateHasChanged();
        }
    }

    private void Halt()
    {
        _going?.Cancel();
        _going = null;
    }

    // Any other key takes the run out of its own hands first.
    private void Step()
    {
        Halt();
        _session.Step();
        Touch();
    }

    private void Back()
    {
        Halt();
        _session.StepBack();
        Touch();
    }

    private void Reset()
    {
        Halt();
        _session.Reset();
        Touch();
    }

    private void Seek(ulong cycle)
    {
        Halt();
        _session.Seek(cycle);
        Touch();
    }

    private void Faster() => _pace = _pace.Next();

    // How many files have been saved: the key of the menu, so that each choice leaves a new
    // menu behind it.
    private int _exported;

    /// <summary>Hands the reader the run as a file of the kind chosen from the menu.</summary>
    private async Task Export(ChangeEventArgs change)
    {
        _exported++;
        if (!Enum.TryParse<ExportKind>(change.Value as string, out var kind)
            || SessionExport.Make(_session, kind, Messages) is not { } file)
        {
            return;
        }

        Halt();
        await Js.InvokeVoidAsync(kind == ExportKind.Png ? "fetchlineExport.savePicture" : "fetchlineExport.save", file.Name, file.MediaType, file.Text);
    }

    // The handle of the timeline has been moved to a cycle.
    private void Scrub(ChangeEventArgs change)
    {
        if (ulong.TryParse(change.Value as string, NumberStyles.None, CultureInfo.InvariantCulture, out var cycle))
        {
            Seek(cycle);
        }
    }

    // How far along the run so far the cycle on screen is, in hundredths: the lit part of the timeline.
    private string Fraction() => _session.Frontier == 0
        ? "0"
        : (100.0 * _session.Cycle / _session.Frontier).ToString("0.##", CultureInfo.InvariantCulture);

    /// <summary>
    /// Notes that what is on screen has changed. Once it has stayed as it is for a moment, and
    /// is not running, the address is brought up to date with it: not at every keystroke or
    /// every cycle of a run, which would be a great deal of work for an address nobody reads.
    /// </summary>
    private void Touch()
    {
        var mine = ++_touched;
        _ = Settle();

        async Task Settle()
        {
            await Task.Delay(SettleMilliseconds);
            if (mine == _touched && !Going)
            {
                Link();
            }
        }
    }

    /// <summary>
    /// Puts a link to what is on screen in the page's address. False when it cannot be put in a
    /// link: a source too long, or a cycle too far on; the address then holds no link at all,
    /// which is better than one to something else.
    /// </summary>
    private bool Link()
    {
        try
        {
            Page.InvokeVoid("fetchlineLink.write", ShareLink.Encode(new Shared(_session.Source, _session.Config, _session.Cycle)));
            return true;
        }
        catch (ArgumentException)
        {
            Page.InvokeVoid("fetchlineLink.write", string.Empty);
            return false;
        }
    }

    /// <summary>Makes the address a link to what is on screen now, and copies it if the browser allows.</summary>
    private async Task Share()
    {
        Halt();
        _touched++;
        if (!Link())
        {
            Say(Messages.LinkNotMade);
        }
        else
        {
            Say(await Js.InvokeAsync<bool>("fetchlineLink.copy") ? Messages.LinkCopied : Messages.LinkInAddress);
        }

        StateHasChanged();
    }

    /// <summary>Says something on the status line for a few seconds.</summary>
    private void Say(string notice)
    {
        _notice = notice;
        var mine = ++_noticed;
        _ = Clear();

        async Task Clear()
        {
            await Task.Delay(NoticeMilliseconds);
            if (mine == _noticed)
            {
                _notice = string.Empty;
                StateHasChanged();
            }
        }
    }
}
